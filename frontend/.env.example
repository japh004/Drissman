# Copier en `.env.local` (gitignoré) pour le développement.
# URL du backend : le client ajoute `/api` automatiquement s'il manque.
#   - backend lancé en local  : http://localhost:8080
#   - backend de production   : https://drisman.yowyob.com/drissman-api
#     (domaine à UN « s », chemin à DEUX « s »)
NEXT_PUBLIC_API_URL=http://localhost:8080
